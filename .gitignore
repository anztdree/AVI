# ============================================================
#  REPO INI KHUSUS PROYEK APK AVI — rules di bawah DIKUNCI.
#  Yang boleh masuk repo HANYA:
#    - android-app/            (sumber APK Kotlin+Compose)
#    - build.gradle.kts / settings.gradle.kts / gradle.properties
#    - .github/workflows/build-android.yml  (CI build APK)
#    - public/avi-agent.html   (mockup display sebelum dikemas APK)
#    - docs/                   (RENCANA, SPESIFIKASI, RIWAYAT)
#    - README.md, .gitignore
#  Sisanya = scaffolding sandbox (Next.js/Bun) yang HANYA hidup di
#  lokal untuk preview — jangan pernah di-commit lagi.
# ============================================================

# --- runtime & dependensi ---
node_modules/
.next/
out/
build/
coverage/
*.log
dev.log
dev.out.log
server.log
*.pid
.env*
.vercel
*.tsbuildinfo
next-env.d.ts
.DS_Store

# --- scaffolding Next.js/Bun (lokal saja) ---
/src/
/examples/
/tests/
/mini-services/
/db/
/prisma/
/.zscripts/
Caddyfile
bun.lock
bun.lockb
package.json
package-lock.json
yarn.lock
components.json
next.config.ts
tsconfig.json
tailwind.config.ts
postcss.config.mjs
eslint.config.mjs

# --- public: hanya mockup AVI yang boleh ---
/public/*
!/public/avi-agent.html

# --- GitHub: hanya workflow build APK ---
/.github/workflows/*
!/.github/workflows/build-android.yml

# --- folder kerja tool lokal ---
.claude/
.z-ai-config/
skills/
tool-results/
agent-ctx/
prompt
test
local-*
