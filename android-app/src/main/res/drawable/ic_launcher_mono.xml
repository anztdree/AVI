<?xml version="1.0" encoding="utf-8"?>
<!-- Monochrome layer (Android 13+ themed icon) — P49: glyph reaktor mewah
     (cincin luar + cincin gigi + inti), selaras ikon orba emas-cyan baru -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Cincin luar -->
    <path
        android:pathData="M54,30 a24,24 0 1,0 0.01,0 z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:fillColor="#00000000" />

    <!-- Cincin gigi (ring bergerigi — segmen sekitar inti) -->
    <path
        android:pathData="M54,38.5 a15.5,15.5 0 1,0 0.01,0 z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:strokeAlpha="0.9"
        android:fillColor="#00000000" />

    <!-- Inti bercahaya -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,47.5 a6.5,6.5 0 1,0 0.01,0 z" />

    <!-- Titik pivot 4 arah pada cincin luar -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,26.5 a2.4,2.4 0 1,0 0.01,0 z M81.5,54 a2.4,2.4 0 1,0 0.01,0 z M54,81.5 a2.4,2.4 0 1,0 0.01,0 z M26.5,54 a2.4,2.4 0 1,0 0.01,0 z" />
